# 服务端口
PORT=3000

# MySQL 连接串：mysql://用户名:密码@主机:端口/数据库
DATABASE_URL="mysql://classbook:classbook123@127.0.0.1:3306/class_directory"

# JWT 密钥（生产环境务必改成随机长字符串）与有效期
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# 初始管理员（班主任）账号，仅在 seed 时使用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=班主任

# 每日生日提醒的执行时间（cron 表达式，时区 Asia/Shanghai）与提前天数
REMINDER_CRON="0 8 * * *"
REMINDER_ADVANCE_DAYS=1

# 邮件提醒（可选）：SMTP_HOST 留空则不发送邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
